PORT=5000
NODE_ENV=development

# Database — local MongoDB for dev, MongoDB Atlas connection string in production
MONGO_URI=mongodb://localhost:27017/local

# Auth — generate long random strings, don't reuse these across environments
# (e.g. `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary — required (avatars + task attachments)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google sign-in (OPTIONAL — leave blank to disable it entirely. The app
# runs fine on email/password alone; the frontend simply won't render
# the Google button when this isn't set.) Only the Client ID is needed.
GOOGLE_CLIENT_ID=

# Email verification (OPTIONAL — leave blank to disable it entirely.
# New accounts are auto-verified when unset, same as before this was
# added.) Resend (resend.com) — an HTTPS email API, not raw SMTP.
# Deliberately not Gmail/SMTP: most free hosting platforms (including
# Render's free tier) block outbound SMTP ports as standard anti-spam
# practice, which makes SMTP unusable there regardless of provider.
# Get a free API key at resend.com/api-keys (no credit card required).
RESEND_API_KEY=
# Optional — defaults to Resend's shared onboarding@resend.dev, which
# only delivers to the email your Resend account itself was created
# with. Set this to an address on a domain you've verified in the
# Resend dashboard to send to arbitrary real users.
EMAIL_FROM=

# CORS — the frontend's URL (Vite dev server locally, your Vercel
# deployment in production). No trailing slash.
CLIENT_URL=http://localhost:5173
