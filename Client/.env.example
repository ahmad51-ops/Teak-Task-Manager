# Only needed if you deploy the frontend separately from the backend
# (different origin) — e.g. frontend on Vercel, backend on Render. In
# local dev, the Vite proxy in vite.config.js handles this instead, so
# this can stay unset. No trailing slash, no /api/v1 suffix — just the
# backend's base URL (axios.js and socket.js each append what they need).
# Example: VITE_API_URL=https://team-task-manager-api.onrender.com
VITE_API_URL=
